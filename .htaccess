# IIRuChating — статический лендинг iiruchating.ru
# Настройки для Apache (виртуальный хостинг reg.ru).

DirectoryIndex index.html

# Своя страница 404
ErrorDocument 404 /404.html

# Редирект www.iiruchating.ru -> iiruchating.ru (301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.iiruchating\.ru$ [NC]
  RewriteRule ^(.*)$ https://iiruchating.ru/$1 [R=301,L]
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 month"
  ExpiresByType image/png                "access plus 1 month"
  ExpiresByType image/x-icon             "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Служебные файлы — наружу не отдаём
# (web-app-manifest.json трогать нельзя: он нужен сайту)
<FilesMatch "^\.|\.(md|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
